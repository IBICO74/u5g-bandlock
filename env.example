# u5g-bandlock config — copy to /root/.config/u5g-bandlock/env (chmod 600)

# The U5G modem on your LAN
MODEM_IP=192.168.1.53
# SIM ICCID — on the modem: ssh in and `cat /etc/uiwwand.json`, or check the
# UniFi console under Internet → your 5G WAN
ICCID=8947000000000000000

# Bands to allow. Find your carrier's bands and drop the noisy one(s).
# Example: Telenor NO, excluding B3 (bad SINR anchor): 1,7,20,28
LTE_BAND=1,7,20,28
NR5G_SA_BAND=1,3,28,78
MODE=5gnr,lte

# Modem SSH auth — EITHER set the device SSH password statically:
#MODEM_SSH_PASSWORD=...
#MODEM_USER=...
# OR let the script fetch it live from the UniFi Network API (recommended —
# survives password rotation). Create an API key: console → Settings →
# Control Plane → Integrations → Create API Key.
UNIFI_HOST=192.168.1.1
UNIFI_API_KEY=...
MODE=5gnr,lte
